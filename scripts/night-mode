#!/usr/bin/env node
"use strict";

const childProcess = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const runnerRoot = path.resolve(__dirname, "..");
const entryFile = path.join(runnerRoot, "dist", "index.js");
const packageFile = path.join(runnerRoot, "package.json");
const lockFile = path.join(runnerRoot, "package-lock.json");
const typescriptBin = path.join(runnerRoot, "node_modules", "typescript", "bin", "tsc");

function fail(message) {
  process.stderr.write(`night-mode: ${message}\n`);
  process.exit(1);
}

function commandName(name) {
  return process.platform === "win32" ? `${name}.cmd` : name;
}

function available(command) {
  const result = childProcess.spawnSync(command, ["--version"], { stdio: "ignore", windowsHide: true });
  return !result.error && result.status === 0;
}

function run(command, args, label) {
  const result = childProcess.spawnSync(command, args, {
    cwd: runnerRoot,
    stdio: "inherit",
    windowsHide: true,
    env: process.env
  });
  if (result.error) fail(`${label} could not start: ${result.error.message}`);
  if (result.status !== 0) fail(`${label} failed with exit code ${result.status ?? "unknown"}.`);
}

function packageManager() {
  const npm = commandName("npm");
  if (available(npm)) return { command: npm, installArgs: fs.existsSync(lockFile) ? ["ci"] : ["install"], buildArgs: ["run", "build"] };
  const pnpm = commandName("pnpm");
  if (available(pnpm)) return { command: pnpm, installArgs: ["install", "--frozen-lockfile=false"], buildArgs: ["run", "build"] };
  fail("build dependencies are missing and neither npm nor pnpm is available. Install Node.js 22+ with npm, then retry.");
}

function newestSourceTime() {
  const files = [packageFile, lockFile, path.join(runnerRoot, "tsconfig.json")];
  const sourceDir = path.join(runnerRoot, "src");
  if (fs.existsSync(sourceDir)) {
    for (const name of fs.readdirSync(sourceDir)) if (name.endsWith(".ts")) files.push(path.join(sourceDir, name));
  }
  return Math.max(...files.filter((file) => fs.existsSync(file)).map((file) => fs.statSync(file).mtimeMs));
}

function commandArgument(value) {
  return /^[A-Za-z0-9_./:\\-]+$/.test(value) ? value : `"${value.replaceAll('"', '\\"')}"`;
}

const nodeMajor = Number(process.versions.node.split(".")[0]);
if (!Number.isInteger(nodeMajor) || nodeMajor < 22) fail(`Node.js 22 or newer is required; found ${process.versions.node}.`);
if (!fs.existsSync(packageFile)) fail(`runner package metadata was not found at ${packageFile}. Reinstall the skill.`);

let manager;
if (!fs.existsSync(typescriptBin)) {
  manager = packageManager();
  run(manager.command, manager.installArgs, "dependency installation");
}

const needsBuild = !fs.existsSync(entryFile) || fs.statSync(entryFile).mtimeMs < newestSourceTime();
if (needsBuild) {
  manager ??= packageManager();
  run(manager.command, manager.buildArgs, "runner build");
}
if (!fs.existsSync(entryFile)) fail(`runner build did not create ${entryFile}.`);

const wrapperCommand = `${commandArgument(process.execPath)} ${commandArgument(path.resolve(__filename))}`;
const result = childProcess.spawnSync(process.execPath, [entryFile, ...process.argv.slice(2)], {
  cwd: process.cwd(),
  stdio: "inherit",
  windowsHide: true,
  env: { ...process.env, CODEX_WORKFLOW_COMMAND: wrapperCommand }
});
if (result.error) fail(`runner could not start: ${result.error.message}`);
process.exitCode = result.status ?? 1;
